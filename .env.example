# Copy to .env and edit. docker-compose reads this automatically.

# --- Postgres ---
POSTGRES_USER=staffadmin
POSTGRES_PASSWORD=staffpass
POSTGRES_DB=staffmgmt

# --- Backend ---
# Generate a strong secret, e.g.:  openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# First-run Super Admin. CHANGE THE PASSWORD before exposing the app publicly
# (e.g. via the Cloudflare tunnel) — this default is well-known.
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_TENANT_ID=1

# --- Cloudflare tunnel (optional) ---
# Token from Cloudflare Zero Trust > Networks > Tunnels > (your tunnel) > Docker.
# Then run:  docker compose --profile tunnel up -d
# In the dashboard, route your public hostname to  http://backend:8000
# Leave blank if you're not using the tunnel.
TUNNEL_TOKEN=
